{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiaia.dev/schemas/v1/deposit_plan.json",
  "title": "GuiaIA Chest Deposit Plan",
  "description": "Defines an authorized, bounded container deposit transaction plan",
  "type": "object",
  "required": ["ownerName", "chest", "items"],
  "properties": {
    "version": { "type": "integer", "const": 1, "default": 1 },
    "sandboxOnly": { "type": "boolean", "default": true },
    "ownerName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]{3,16}$"
    },
    "chest": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "integer", "minimum": -64, "maximum": 320 },
        "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["oak_log", "birch_log", "cobblestone", "stone", "coal"]
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 16 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
