{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiaia.dev/schemas/v1/mission_state.json",
  "title": "GuiaIA Mission State Journal",
  "description": "Defines the durable persistence journal state for a running or completed mission",
  "type": "object",
  "required": ["version", "missionId", "ownerName", "targets", "index", "receipts", "phase"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "sandboxOnly": { "type": "boolean" },
    "missionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "ownerName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]{3,16}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["x", "y", "z"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "z": { "type": "integer" },
          "block": { "type": "string" }
        }
      }
    },
    "index": { "type": "integer", "minimum": 0 },
    "phase": {
      "type": "string",
      "enum": ["ready", "dispatching", "needs_review", "paused", "completed", "cancelled"]
    },
    "operationId": {
      "type": ["string", "null"]
    },
    "reason": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "operationId", "item", "inventoryDelta"],
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "operationId": { "type": "string" },
          "item": { "type": "string" },
          "inventoryDelta": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
